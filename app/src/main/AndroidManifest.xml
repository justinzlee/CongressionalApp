<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BeachSafetyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BeachDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <!-- Tab roots stay in the one task; TabBar brings an existing screen
             back to the front rather than stacking another copy. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ContactDeveloperActivity"
            android:exported="false"
            android:label="@string/contact_developers_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".AlertsActivity"
            android:exported="false"
            android:label="@string/tab_alerts"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".SavedActivity"
            android:exported="false"
            android:label="@string/tab_saved"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".LearnActivity"
            android:exported="false"
            android:label="@string/tab_learn"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".RipGuideActivity"
            android:exported="false"
            android:label="@string/guide_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".DrowningGuideActivity"
            android:exported="false"
            android:label="@string/drowning_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".FlagGuideActivity"
            android:exported="false"
            android:label="@string/flag_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".UvGuideActivity"
            android:exported="false"
            android:label="@string/uv_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".PracticeActivity"
            android:exported="false"
            android:label="@string/practice_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".WildlifeGuideActivity"
            android:exported="false"
            android:label="@string/wildlife_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".StingGuideActivity"
            android:exported="false"
            android:label="@string/sting_title"
            android:theme="@style/Theme.MyApplication" />

        <!-- The two things somebody standing on the sand can report about a
             beach. Both are opened from the beach detail screen and both hand
             their result back through the stores rather than an activity
             result, so the detail screen picks them up in onResume. -->
        <activity
            android:name=".RockRatingActivity"
            android:exported="false"
            android:label="@string/rocks_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".SightingActivity"
            android:exported="false"
            android:label="@string/sighting_title"
            android:theme="@style/Theme.MyApplication" />

        <!-- Beaches ranked by what you actually want to do there. -->
        <activity
            android:name=".ActivityRankingActivity"
            android:exported="false"
            android:label="@string/activity_title"
            android:theme="@style/Theme.MyApplication" />

        <!-- Lets the camera app write a capture into our cache when someone
             adds their own photo of a beach. Not exported: the grant is handed
             to one app, for one file, for as long as that capture takes. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
