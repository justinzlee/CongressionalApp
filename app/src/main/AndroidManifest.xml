<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BeachSafetyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BeachDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <!-- Tab roots stay in the one task; TabBar brings an existing screen
             back to the front rather than stacking another copy. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".AlertsActivity"
            android:exported="false"
            android:label="@string/tab_alerts"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".SavedActivity"
            android:exported="false"
            android:label="@string/tab_saved"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".RipGuideActivity"
            android:exported="false"
            android:label="@string/guide_title"
            android:theme="@style/Theme.MyApplication" />

    </application>

</manifest>
