<?xml version="1.0" encoding="utf-8"?>
<!--
  Beach Safety Palette, light mode. Sun-bright warmth over muted coastal
  neutrals: sand carries the page, sea teal carries the brand and every
  interactive element, sun amber marks sunlight and UV, and coral is
  reserved for warnings so it never appears decoratively.

  Ramp values are verbatim from the design. Sand 00 is the app ground and
  cards nest a step warmer on it (Sand 50), the direction the design's own
  screen mockup nests its tiles.
-->
<resources>
    <!-- Sea: brand, links, controls. 500 is the primary, 700 for pressed
         states and for sea-colored text on sand. -->
    <color name="primary">#147384</color>
    <color name="primary_variant">#0A4757</color>
    <color name="on_primary">#EBF7F9</color>

    <!-- Sand: the ground is a step darker than the cards, so a card stands
         off the page by its own lightness instead of by an outline. 100
         recessed, 200 hairline, 600 muted text, Ink body text. -->
    <color name="background">#F2ECE2</color>
    <color name="surface">#FFFDF9</color>
    <color name="surface_alt">#EDE6DA</color>
    <color name="divider">#DCD3C4</color>
    <color name="text_primary">#211F1B</color>
    <color name="text_secondary">#6E6659</color>

    <!-- Semantic safety scale. The design pairs each state with a tint for
         backgrounds; the tints below are its literal values.

         Caution is the one deviation: the design's caution swatch is Sun
         #F0A20A, but the app uses these tokens as text and icon colors,
         and the design's own rules put amber at that lightness in
         backgrounds only ("pair with Sun 800 text"). Caution therefore
         takes Sun 700, which clears AA both on Sand 00 and on its tint -
         which matters most in the sunlight this app is read in. -->
    <color name="safe">#127A4D</color>
    <color name="caution">#9A5B06</color>
    <color name="danger">#B42E17</color>
    <color name="safe_tint">#E2F6EC</color>
    <color name="caution_tint">#FEF0D0</color>
    <color name="danger_tint">#FEE1DA</color>
    <color name="accent_tint">#EBF7F9</color>

    <!-- The band the search button sits on, at the foot of the Find a beach
         card. Barely a colour - a five-percent wash of Sea over the card, just
         enough to read as a separate shelf below the hairline. -->
    <color name="search_footer">#0D147384</color>

    <!-- Legacy aliases kept so existing layouts and code keep resolving -->
    <color name="error">#B42E17</color>
    <color name="advisor_bg">#EBF7F9</color>
    <color name="secondary">#BF730B</color>
    <color name="on_secondary">#FFF8E6</color>
    <color name="tertiary_gold">#BF730B</color>
    <!-- The header is a flat sand ground, not a colored band. -->
    <!-- Text/icons over photo scrims, which stay dark in both themes -->
    <color name="on_hero">#FFFFFF</color>
    <!-- The verdict over a photo. The scrim under it is dark in both themes,
         so it takes the bright (night) safety colours in both, not the
         darkened light-mode text colours above. Not repeated in values-night. -->
    <color name="safe_on_hero">#55CE9B</color>
    <color name="caution_on_hero">#FACE6B</color>
    <color name="danger_on_hero">#F4947F</color>

    <!-- Beach warning flags. These are the physical colors of the flags
         flying on the beach, so unlike everything above they are the same
         in both themes - a red flag is red whichever way the app looks.
         The design keeps them out of the brand set for the same reason:
         a legal signal must never be mistaken for UI color. -->
    <color name="flag_red">#D8342A</color>
    <color name="flag_yellow">#F0C420</color>
    <color name="flag_green">#26A65B</color>
    <color name="flag_purple">#7E45B5</color>

    <!-- UV Index scale: safe green, caution amber, then up the sun ramp
         into coral. Extreme is Coral 800 rather than a violet, so the
         scale never leaves the palette. -->
    <color name="uv_low">#1DA46A</color>
    <color name="uv_moderate">#BF730B</color>
    <color name="uv_high">#DF6E1E</color>
    <color name="uv_very_high">#E03C21</color>
    <color name="uv_extreme">#85230F</color>

    <!-- Stat tile icons: temperature in Sun 800, the rest muted sand. -->
    <color name="icon_temp">#BF730B</color>
    <color name="icon_wind">#6E6659</color>

    <!--
      Flagline brand. The identity sheet's own palette, and the one set of
      colours in this file that values-night deliberately does NOT override:
      the launch screen is the brand's own ground rather than a surface of the
      app, so it is the deep sea at midday and at midnight alike. The app's
      interface keeps using the theme-aware tokens above.
    -->
    <color name="brand_deep">#0A4757</color>
    <color name="brand_sea">#147384</color>
    <color name="brand_mid">#2E93A3</color>
    <color name="brand_shallow">#61B4C1</color>
    <color name="brand_foam">#9CD3DB</color>
    <!-- The launch screen's waiting bar runs over a track of the same foam. -->
    <color name="brand_foam_track">#339CD3DB</color>
    <color name="brand_sand">#EDE6DA</color>
    <color name="brand_shell">#FDFBF7</color>
    <color name="brand_flag">#EA5C41</color>
    <color name="brand_sun">#F7A828</color>

    <!-- Beach-photo placeholder. A drawn daylight shoreline, shown where there
         is no verified photo of that beach: sky over sea over sand, with an
         umbrella and a beach ball so the slot reads as a scene rather than a
         broken image. Chosen over the after-dark set in values-night by where
         the sun is at that beach, not by the phone's theme. The ramps are
         listed sky-down and sea-down, in the order the vector's gradient stops
         consume them. -->
    <color name="placeholder_sky">#49B9DC</color>
    <color name="placeholder_sky_mid">#84D6E8</color>
    <color name="placeholder_sky_low">#C7ECF1</color>
    <color name="placeholder_sky_haze">#E7F6F3</color>

    <color name="placeholder_sun_core">#FFF8D4</color>
    <color name="placeholder_sun_mid">#FFD65E</color>
    <color name="placeholder_sun_edge">#FCB92E</color>
    <!-- Halo around the sun. It fades to a transparent copy of its own hue so
         the ramp ends invisibly rather than on a grey ring. -->
    <color name="placeholder_sun_glow">#73FFD65E</color>
    <color name="placeholder_sun_glow_fade">#00FFD65E</color>

    <!-- The one near-white in the scene: clouds, swell crests, the foam line
         and the beach ball all share it. -->
    <color name="placeholder_light">#FFFDF6</color>
    <color name="placeholder_bird">#0C5F79</color>
    <color name="placeholder_kite_tail">#1B2A2E</color>

    <color name="placeholder_sea_shore">#5FD0D6</color>
    <color name="placeholder_sea">#26A6C1</color>
    <color name="placeholder_sea_mid">#1483A2</color>
    <color name="placeholder_sea_deep">#0B5871</color>
    <color name="placeholder_swell_near">#CFF0F4</color>
    <!-- Glint on the horizon: bright in the middle, tailing off at both ends. -->
    <color name="placeholder_horizon_core">#F2FFFDF6</color>
    <color name="placeholder_horizon_edge">#40FFFDF6</color>

    <color name="placeholder_sand_wet">#FBDCA4</color>
    <color name="placeholder_sand_dry">#F3C27C</color>
    <color name="placeholder_shade">#D9A263</color>

    <!-- Umbrella and beach ball -->
    <color name="placeholder_pole">#8A6A4A</color>
    <color name="placeholder_canopy">#FFF1DA</color>
    <color name="placeholder_accent">#F2643C</color>
    <color name="placeholder_accent_edge">#C74A26</color>

    <!-- Objects belonging to the other four placeholder scenes. The umbrella
         scene needs none of these; the palm, surfboard, tower and sandcastle
         reuse the tokens above wherever the design let them, and add only what
         genuinely has no equivalent in the daylight palette. -->
    <color name="placeholder_palm_trunk">#B07A45</color>
    <color name="placeholder_palm_trunk_edge">#5A3A1E</color>
    <color name="placeholder_frond_light">#5CB489</color>
    <color name="placeholder_frond_mid">#4FA97F</color>
    <color name="placeholder_frond_dark">#3E9C77</color>
    <color name="placeholder_frond_deep">#2E7A5E</color>
    <color name="placeholder_frond_edge">#1E4A38</color>
    <color name="placeholder_coconut">#C88A43</color>

    <!-- Drawn edge for things made of sand or canvas: the towel hem, the tower
         deck, the castle walls. Darker than the dry sand it outlines. -->
    <color name="placeholder_sand_edge">#C48A3E</color>
    <color name="placeholder_towel_fold">#FFE9AF</color>

    <color name="placeholder_castle">#E8B778</color>
    <color name="placeholder_castle_shade">#D19A55</color>

    <!-- A kite sail. The same teal as the sea by day, which is the design’s
         intent, but its own token because after dark the sea darkens into the
         night sky and a kite painted in it disappears. -->
    <color name="placeholder_kite_sail">#26A6C1</color>

    <!-- Rock-scale reference pictures. The three drawn patches of shore that
         anchor the 0-10 rocks rating at 3, 5 and 9.

         Deliberately NOT the placeholder_* sand tokens above, and deliberately
         not overridden in values-night. Those tokens turn into an after-dark
         beach at night, which is right for a hero image and wrong here: these
         three pictures are a measuring scale, and a scale that changes colour
         with the phone's theme is no longer the same scale. Same reasoning as
         the warning flags - what is depicted is a physical thing, so it looks
         the same whichever way the app is set. -->
    <color name="rocks_ref_water">#6FC9D4</color>
    <color name="rocks_ref_sand_wet">#DCB985</color>
    <color name="rocks_ref_sand">#EDCF9B</color>
    <color name="rocks_ref_rock_light">#CFC7B8</color>
    <color name="rocks_ref_rock_mid">#A69D8C</color>
    <color name="rocks_ref_rock_dark">#7D7566</color>

    <!-- Beach map. The card and everything floating over the imagery - the
         zoom and Satellite / Plain controls and the two pills - follow the
         theme like any other card: sand here, and the design's own dark set in
         values-night. The markers - towers, you, and the arrow pointing back
         at you - are symbols on the map rather than interface, drawn to stand
         out against a satellite photograph, and are the same in both. -->
    <!-- Under the map while its tiles are still arriving -->
    <color name="map_ground">#EDE6DA</color>
    <color name="map_hud">#F0F6F1E8</color>
    <color name="map_hud_edge">#DCD3C4</color>
    <color name="map_hud_text">#211F1B</color>
    <color name="map_hud_text_quiet">#6E6659</color>
    <!-- The look that is on, Satellite or Plain: the one accent, like every other selected control -->
    <color name="map_hud_active">@color/primary</color>
    <color name="map_hud_active_text">#FFFFFF</color>
    <color name="map_hud_ripple">#1F000000</color>
    <color name="map_chip">#CCFDFBF7</color>
    <color name="map_chip_text">#6E6659</color>
    <color name="map_you_chip">#D1FDFBF7</color>
    <color name="map_you_text">#3D3831</color>
    <color name="map_tower">#FACE6B</color>
    <color name="map_tower_ink">#0B1418</color>
    <color name="map_user">#61B4C1</color>
    <color name="map_user_rim">#EAF1F0</color>
    <color name="map_arrow">#2E8FC9</color>
    <color name="map_arrow_shade">#1B5E8C</color>
    <color name="map_arrow_outline">#0A1116</color>
    <color name="map_arrow_rim">#EAF1F0</color>
    <!-- The card's kicker: secondary text by day. At night the design sets it
         a step quieter than the legend under the map. -->
    <color name="map_kicker">@color/text_secondary</color>

    <!-- Wave height card, by day: a pale sky over the drawn daylight
         shoreline's sea. Those placeholder_sea values are written out here
         rather than referenced because they follow the sun at the beach, and
         this card follows the theme like the page around it. values-night
         holds the design's own night set. The front swell's crest takes the
         reading's colour in both - see WaveScale. -->
    <color name="wave_card_sky_top">#EAF4F6</color>
    <color name="wave_card_sky_bottom">#D2E9EE</color>
    <color name="wave_card_edge">#14211F1B</color>
    <color name="wave_card_back_top">#B37CC4D2</color>
    <color name="wave_card_back_bottom">#CC3E8FA6</color>
    <color name="wave_card_mid_top">#E67FD3CF</color>
    <color name="wave_card_mid_bottom">#F22A7F99</color>
    <color name="wave_card_mid_edge">#80FFFFFF</color>
    <color name="wave_card_front_shadow">#4D0B5871</color>
    <color name="wave_card_front_mid">#26A6C1</color>
    <color name="wave_card_front_deep">#1483A2</color>
    <color name="wave_card_front_bed">#0B5871</color>
    <color name="wave_card_guide">#66211F1B</color>
    <color name="wave_card_number">#211F1B</color>
    <color name="wave_card_unit">#6E6659</color>
    <color name="wave_card_number_glow">#B3FDFBF7</color>

    <!-- The loader that stands where a reading will land (SwellLoaderView):
         a pill of daylight sea under a low sun, with a lifebuoy riding the
         swell. The sky is a step bluer than the accent tint so the pill holds
         its shape on a cream tile; the swells are the brand's own sea ramp,
         and the buoy wears the flag colour the launch screen does. -->
    <color name="loader_sky">#DDF0F3</color>
    <color name="loader_sun">#F7A828</color>
    <color name="loader_swell_back">#9CD3DB</color>
    <color name="loader_swell_front">#2E93A3</color>
    <color name="loader_swell_deep">#147384</color>
    <color name="loader_buoy">#EA5C41</color>
    <color name="loader_buoy_band">#FFFFFF</color>
    <color name="loader_buoy_rim">#8C0A4757</color>
    <color name="loader_foam">#D9FFFFFF</color>
</resources>
