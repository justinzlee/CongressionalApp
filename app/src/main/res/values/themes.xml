<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/advisor_bg</item>
        <item name="colorOnPrimaryContainer">@color/primary_variant</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/surface_alt</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/tertiary_gold</item>
        <item name="colorTertiaryContainer">@color/surface_alt</item>
        <item name="colorOnTertiaryContainer">@color/text_primary</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/background</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="colorSurfaceContainerHighest">@color/surface_alt</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/error</item>

        <!-- Shape scale: radius-sm 4, md 8, lg 14 -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Corner.ExtraLarge</item>

        <!-- The design sets Space Grotesk; Android ships Roboto, the nearest
             system grotesque, so weights map rather than the exact face. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- The header is a flat ground in this design, not a colored band,
             so status bar content follows the theme. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
      What the window is painted with between the icon being tapped and the
      first frame of the launch screen. Without it the window opens on the
      app's sand ground and the deep sea arrives as a flash of the wrong
      colour. MainActivity drops it again once the launch screen has handed
      over, so nothing is left painting behind an opaque screen.

      Not repeated in values-night: the launch screen is the brand's own
      ground and is the deep sea in both themes.
    -->
    <style name="Theme.MyApplication.Launch">
        <item name="android:windowBackground">@color/brand_deep</item>
    </style>

    <!-- Shape scale -->
    <style name="ShapeAppearance.App.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Type. Headings are weight 500, body 400. -->
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <!-- Screen headline, e.g. the beach name on the detail screen -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>
    <!-- Section kickers: 11sp, uppercase, wide tracking, muted -->
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <!-- Stat tile labels sit a touch smaller than section kickers -->
    <style name="TextAppearance.App.TileLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.App.StatValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Widgets -->

    <!-- Stat tile: label row over a value, on a hairline surface card -->
    <style name="Widget.App.StatTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_surface_card</item>
        <!-- Split edges rather than padding{Horizontal,Vertical}: those are
             API 26+, and in a style (unlike a layout) they are silently
             dropped below that, which minSdk 24 would hit. -->
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>
    <style name="Widget.App.StatTileLabelRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Widget.App.StatTileIcon" parent="">
        <item name="android:layout_width">13dp</item>
        <item name="android:layout_height">13dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_secondary</item>
    </style>
    <style name="Widget.App.StatTileLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.TileLabel</item>
    </style>
    <style name="Widget.App.StatTileValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.StatValue</item>
    </style>
    <!-- A quiet second line under a tile value, e.g. how far off a tide is -->
    <style name="Widget.App.StatTileCaption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
      Home hero tile: one of the four readings folded into the verdict card.
      Unlike Widget.App.StatTile it carries no icon - inside the card the four
      labels already sit in a 2x2 block that reads as a set, and four more
      glyphs only crowd it.
    -->
    <style name="Widget.App.HeroStatTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_stat_tile</item>
        <!-- Split edges rather than padding{Horizontal,Vertical}: those are
             API 26+, and in a style (unlike a layout) they are silently
             dropped below that, which minSdk 24 would hit. -->
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>
    <style name="Widget.App.HeroStatTileValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- A field inside the search card: the city picker and the name box. -->
    <style name="Widget.App.SearchField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_search_field</item>
        <item name="android:paddingLeft">15dp</item>
        <item name="android:paddingRight">15dp</item>
    </style>

    <!--
      One of the five radius chips. Selection is a background and a colour, not
      a border: five outlined buttons in a row would read as five controls
      rather than one setting with five positions.
    -->
    <style name="Widget.App.RadiusChip" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_radius_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/radius_chip_text</item>
    </style>

    <!-- Bottom tab bar -->
    <style name="Widget.App.Tab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.App.TabIcon" parent="">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_secondary</item>
    </style>
    <style name="Widget.App.TabLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Reporting a wildlife sighting.

         Both sets of choices are painted in code rather than by a selector: the
         backgrounds are GradientDrawables that get mutated on selection, the
         same way the coast chips on the wildlife guide work. A selector would
         need a second drawable per state and would still not colour the icon. -->

    <!-- One of the three species, in a row of three -->
    <style name="Widget.App.SpeciesChoice" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_choice_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- Split edges rather than padding{Horizontal,Vertical}: those are
             API 26+, and in a style (unlike a layout) they are silently
             dropped below that, which minSdk 24 would hit. -->
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Widget.App.SpeciesChoiceIcon" parent="">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_secondary</item>
    </style>
    <style name="Widget.App.SpeciesChoiceLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- In the water, or washed up: full width, because the second one needs
         room to say what it means -->
    <style name="Widget.App.WhereChoice" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_choice_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Widget.App.WhereChoiceMark" parent="">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_secondary</item>
    </style>
    <style name="Widget.App.WhereChoiceLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
