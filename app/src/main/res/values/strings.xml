    <!-- Rip current guide -->
    <string name="guide_entry_title">How to spot a rip current</string>
    <string name="guide_entry_subtitle">Four things to look for, and what to do</string>
    <string name="guide_title">Spot a rip current</string>
    <string name="guide_intro">Stand on high ground and watch the water for a minute before you go in. Rips are the calm-looking lanes, not the breaking waves.</string>
    <string name="guide_signs_heading">What to look for</string>
    <string name="guide_sign_1_title">A darker, calmer lane</string>
    <string name="guide_sign_1_body">Rips look deceptively flat and inviting. Waves break either side of them, not in them.</string>
    <string name="guide_sign_2_title">Sand or foam heading out</string>
    <string name="guide_sign_2_body">Look for churned brown water or foam moving away from the beach past the breakers.</string>
    <string name="guide_sign_3_title">A gap in the breaking waves</string>
    <string name="guide_sign_3_body">Where the white water stops, the water is deeper — that is the rip channel.</string>
    <string name="guide_sign_4_title">Ripples in a straight line</string>
    <string name="guide_sign_4_body">A rippled surface running seaward while the water beside it is smooth.</string>
    <string name="guide_caught_title">Caught in one?</string>
    <string name="guide_caught_body">Don\'t swim against it. Float, keep your head above water, raise an arm and shout. If you can swim, go sideways towards the breaking waves, then back to shore.</string>

