<?xml version="1.0" encoding="utf-8"?>
<!--
  Beach Safety Palette, dark mode. Night drops the sand entirely and sits
  on deep sea: bg #0B1418, surface #122126, raised #172B31, border #22343A,
  text #EAF1F0. Primary lifts to Sea 300 and the accents lighten one step
  so they stay legible against the dark ground - all verbatim from the
  design's dark theme row.
-->
<resources>
    <!-- Sea, lifted: 300 is the primary here, 200 for outlined controls -->
    <color name="primary">#61B4C1</color>
    <color name="primary_variant">#9CD3DB</color>
    <color name="on_primary">#08181C</color>
    <color name="accent_soft">#CDEAEF</color>

    <!-- Grounds -->
    <color name="background">#0B1418</color>
    <color name="surface">#122126</color>
    <color name="surface_alt">#172B31</color>
    <!-- Cards carry a hairline edge, not a drop shadow -->
    <color name="divider">#22343A</color>
    <color name="text_primary">#EAF1F0</color>
    <color name="text_secondary">#9FB3B4</color>

    <!-- Semantic safety scale. Caution and danger are the design's dark
         accent and alert; safe is the light green lifted to sit at the
         same lightness beside them, since the design's dark row carries
         no green of its own. Tints stay translucent so they read as a
         wash over the surface rather than a second block of color. -->
    <color name="safe">#55CE9B</color>
    <color name="caution">#FACE6B</color>
    <color name="danger">#F4947F</color>
    <color name="safe_tint">#2455CE9B</color>
    <color name="caution_tint">#24FACE6B</color>
    <color name="danger_tint">#24F4947F</color>
    <color name="accent_tint">#2461B4C1</color>

    <!-- Legacy aliases kept so existing layouts and code keep resolving -->
    <color name="error">#F4947F</color>
    <color name="safe_green">#55CE9B</color>
    <color name="advisor_bg">#172B31</color>
    <color name="water_accent">#61B4C1</color>
    <color name="secondary">#FACE6B</color>
    <color name="secondary_variant">#FCE09B</color>
    <color name="on_secondary">#08181C</color>
    <color name="tertiary_gold">#FACE6B</color>
    <color name="ocean_gradient_start">#0B1418</color>
    <color name="ocean_gradient_end">#0B1418</color>
    <color name="on_hero">#FFFFFF</color>

    <!-- UV Index scale, lifted to the dark ground. Extreme deepens into
         Coral 500 rather than darkening, which would only disappear. -->
    <color name="uv_low">#55CE9B</color>
    <color name="uv_moderate">#FACE6B</color>
    <color name="uv_high">#F5A96A</color>
    <color name="uv_very_high">#F4947F</color>
    <color name="uv_extreme">#EA5C41</color>

    <!-- Stat tile icons -->
    <color name="icon_temp">#F5A96A</color>
    <color name="icon_uv">#FACE6B</color>
    <color name="icon_wind">#9FB3B4</color>
    <color name="icon_wave">#61B4C1</color>
    <color name="icon_visibility">#9FB3B4</color>

    <color name="tile_temp_bg">#00000000</color>
    <color name="tile_uv_bg">#00000000</color>
    <color name="tile_wind_bg">#00000000</color>
    <color name="tile_wave_bg">#00000000</color>
    <color name="tile_visibility_bg">#00000000</color>

    <!-- Beach-photo placeholder, after dark. Note that these are NOT the dark
         theme's colours: BeachPlaceholder resolves the drawable through a
         configuration whose night bit comes from sunrise and sunset at the
         beach, so this set is what a beach looks like after the sun has gone
         down there, whatever appearance the phone is in. The sun cools all the
         way to a moon rather than staying amber, because a warm disc is the one
         element that cannot simply be dimmed into this sky. -->
    <color name="placeholder_sky">#0E2C3E</color>
    <color name="placeholder_sky_mid">#14415A</color>
    <color name="placeholder_sky_low">#1E5A72</color>
    <color name="placeholder_sky_haze">#2C7286</color>

    <color name="placeholder_sun_core">#F4F7FF</color>
    <color name="placeholder_sun_mid">#DCE6F2</color>
    <color name="placeholder_sun_edge">#B8CBDD</color>
    <color name="placeholder_sun_glow">#4DDCE6F2</color>
    <color name="placeholder_sun_glow_fade">#00DCE6F2</color>

    <color name="placeholder_light">#A8C4D0</color>
    <color name="placeholder_bird">#08202B</color>
    <color name="placeholder_kite_tail">#0A1418</color>

    <color name="placeholder_sea_shore">#1D6A7C</color>
    <color name="placeholder_sea">#12495C</color>
    <color name="placeholder_sea_mid">#0C3547</color>
    <color name="placeholder_sea_deep">#071F2C</color>
    <color name="placeholder_swell_near">#6FA3B2</color>
    <color name="placeholder_horizon_core">#B3CFE3EC</color>
    <color name="placeholder_horizon_edge">#33CFE3EC</color>

    <color name="placeholder_sand_wet">#3A4A4E</color>
    <color name="placeholder_sand_dry">#2A383D</color>
    <color name="placeholder_shade">#1C282C</color>

    <color name="placeholder_pole">#4A3C30</color>
    <color name="placeholder_canopy">#B9CBD4</color>
    <color name="placeholder_accent">#A8452A</color>
    <color name="placeholder_accent_edge">#7A2F1B</color>

    <!-- Welcome intro: the same Sea ramp as light mode, dimmed a step so
         the reveal does not flash white on a night screen. -->
    <color name="wave_deep">#0A4757</color>
    <color name="wave_shallow">#2E93A3</color>
    <color name="wave_foam">#CDEAEF</color>
    <color name="on_wave">#EBF7F9</color>
</resources>
