<?xml version="1.0" encoding="utf-8"?>
<!-- One animal on the selected coast. The tag on the right says how to
     behave around it, and never carries that meaning in colour alone. Cards
     for animals the app has first aid for are tappable, and show the link
     row at the foot; the rest have no footer and are inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speciesCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_surface_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="13dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/speciesName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            tools:text="Round stingray" />

        <TextView
            android:id="@+id/speciesRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_tag_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="10.5sp"
            tools:text="Can sting"
            tools:textColor="@color/danger" />
    </LinearLayout>

    <TextView
        android:id="@+id/speciesBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:lineSpacingMultiplier="1.45"
        android:textAppearance="@style/TextAppearance.App.Subtitle"
        tools:text="Buried in the sand in knee-deep water." />

    <LinearLayout
        android:id="@+id/speciesFirstAid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_first_aid"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/wildlife_first_aid_link"
            android:textColor="@color/primary"
            android:textSize="12.5sp" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/primary" />
    </LinearLayout>
</LinearLayout>
