<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the tag key. The chip column is a fixed width so every
     explanation starts on the same line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/riskKeyChip"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_chip"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="10.5sp"
        tools:text="Can sting"
        tools:textColor="@color/danger" />

    <TextView
        android:id="@+id/riskKeyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:lineSpacingMultiplier="1.4"
        android:textAppearance="@style/TextAppearance.App.Subtitle"
        tools:text="Know the first aid before you go in." />
</LinearLayout>
