<?xml version="1.0" encoding="utf-8"?>
<!--
  Beaches ranked for one activity.

  The activity picker swaps the list below it rather than paging to another
  screen, the same way the coast picker works on the wildlife guide, so
  comparing "where should I surf" against "where should I picnic" is one tap.
  The readings are fetched once and every activity is re-scored from them
  locally, so switching costs nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rankHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/rankBackButton"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@string/back"
                android:textColor="@color/primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rankScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_title"
                android:textAppearance="@style/TextAppearance.App.Headline" />

            <!-- Four chips, filled in by the activity from the enum so the
                 picker cannot drift out of step with what can be scored. -->
            <LinearLayout
                android:id="@+id/rankActivityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/rankBlurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                tools:text="Real swell and light wind" />

            <TextView
                android:id="@+id/rankStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textAppearance="@style/TextAppearance.App.Body"
                tools:text="Reading conditions at every beach…" />

            <LinearLayout
                android:id="@+id/rankList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:clipToOutline="true"
                tools:targetApi="31"
                android:divider="@drawable/divider_inset"
                android:showDividers="middle" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
