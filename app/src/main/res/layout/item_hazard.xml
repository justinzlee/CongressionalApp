<?xml version="1.0" encoding="utf-8"?>
<!-- One "what to watch for" card: severity-tinted icon, title, and detail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="11dp">

    <ImageView
        android:id="@+id/hazardIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_warning_circle"
        app:tint="@color/caution" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hazardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Rip current" />

        <TextView
            android:id="@+id/hazardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.45"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="Strong rips near the pier." />
    </LinearLayout>
</LinearLayout>
