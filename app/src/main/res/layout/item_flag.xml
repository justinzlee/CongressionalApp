<?xml version="1.0" encoding="utf-8"?>
<!-- One warning flag: the flag itself, what it is called, and what it means.
     The colour never carries the meaning on its own - the title always spells
     it out, and the flag column is labelled for screen readers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_surface_card"
    android:orientation="horizontal"
    android:paddingHorizontal="13dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Fixed width so every title starts on the same line, whether the row
         flies one flag or the two of a double red. -->
    <LinearLayout
        android:id="@+id/flagIcons"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|start"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/flagIconPrimary"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_flag"
            tools:tint="@color/flag_red" />

        <ImageView
            android:id="@+id/flagIconSecondary"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginStart="1dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_flag"
            android:visibility="gone"
            tools:tint="@color/flag_red"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/flagTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            tools:text="Double red — Water closed" />

        <TextView
            android:id="@+id/flagBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.45"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="The water is closed to everyone." />
    </LinearLayout>
</LinearLayout>
