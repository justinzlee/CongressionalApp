<?xml version="1.0" encoding="utf-8"?>
<!--
  Nearby-beach row. The design's row is a compact strip (level chip, name +
  short verdict, distance and surf on the right); the photo is kept above it
  because it is real data the app fetches per beach.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:rippleColor="@color/primary"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/beachImage"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/beach_image_desc"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="11dp">

            <!-- Level chip: filled in code with the beach's safety tint -->
            <FrameLayout
                android:id="@+id/beachLevelChip"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_level_chip">

                <ImageView
                    android:id="@+id/beachLevelIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/safe" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/beachName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        tools:text="Santa Monica Beach" />

                    <!-- Lifebuoy marks a beach with a lifeguard station on record -->
                    <ImageView
                        android:id="@+id/beachGuardedIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lifebuoy"
                        android:visibility="gone"
                        app:tint="@color/primary"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/beachVerdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/safe"
                    android:textSize="12sp"
                    tools:text="Good to swim" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/beachDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textSize="12sp"
                    tools:text="0.8 mi" />

                <TextView
                    android:id="@+id/beachSurf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textSize="11sp"
                    tools:text="0.4 m surf" />
            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:alpha="0.45"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
