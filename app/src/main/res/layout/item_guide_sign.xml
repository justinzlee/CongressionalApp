<?xml version="1.0" encoding="utf-8"?>
<!-- One numbered thing to look for when scanning the water for a rip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_surface_card"
    android:orientation="horizontal"
    android:paddingHorizontal="13dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/guideNumber"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_number_chip"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="12.5sp"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/guideSignTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            tools:text="A darker, calmer lane" />

        <TextView
            android:id="@+id/guideSignBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.45"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="Rips look deceptively flat and inviting." />
    </LinearLayout>
</LinearLayout>
