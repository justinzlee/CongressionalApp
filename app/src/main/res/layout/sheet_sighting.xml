<?xml version="1.0" encoding="utf-8"?>
<!--
  What you can do with a sighting already reported: pass it on, or take it back.

  "Warn other people" leads and is the accented row, because for a stranded
  animal that is the whole reason the report exists. It is hidden for a sighting
  out in the water - a dolphin is not something to warn anyone about.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- Grabber -->
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/sightingSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        tools:text="Seal, washed up" />

    <TextView
        android:id="@+id/sightingSheetWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.App.Subtitle"
        tools:text="Reported 2 hours ago at La Jolla Shores" />

    <LinearLayout
        android:id="@+id/sightingSheetShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_accent_note"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_share"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sighting_share_cta"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sightingSheetDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_surface_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="13dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_trash"
            app:tint="@color/danger" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sighting_delete"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
