<?xml version="1.0" encoding="utf-8"?>
<!-- The beach map card's contents. BeachMapCard is the vertical LinearLayout
     these merge into; it adds the map itself behind the markers in code. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/map_kicker"
                android:textAllCaps="true"
                android:textColor="@color/map_kicker"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/map_title"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mapRecenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_map_recenter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_map_recenter_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/map_recenter"
                android:textColor="@color/text_primary"
                android:textFontWeight="600"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:id="@+id/mapFrame"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:background="@color/map_ground">

        <com.example.myapplication.BeachMapMarkers
            android:id="@+id/mapMarkers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Answers a one-finger drag across the map, which the page leaves
             alone and the map no longer takes. Shown and faded in code. -->
        <TextView
            android:id="@+id/mapGestureHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_map_hint"
            android:elevation="6dp"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/map_two_finger_hint"
            android:textColor="@color/map_hud_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mapZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_map_hud_group"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/mapZoomIn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_hud_button"
                android:contentDescription="@string/map_zoom_in"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/map_hud_text"
                android:textSize="20sp"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/map_hud_edge" />

            <TextView
                android:id="@+id/mapZoomOut"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_hud_button"
                android:contentDescription="@string/map_zoom_out"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/map_hud_text"
                android:textSize="20sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/mapScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_map_chip"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/map_chip_text"
            android:textSize="10sp"
            tools:text="190 m" />

        <LinearLayout
            android:id="@+id/mapStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_map_hud_group"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/mapSatellite"
                android:layout_width="76dp"
                android:layout_height="34dp"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_map_hud_button"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/map_satellite"
                android:textFontWeight="600"
                android:textSize="11sp"
                tools:background="@color/map_hud_active"
                tools:textColor="@color/map_hud_active_text" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/map_hud_edge" />

            <TextView
                android:id="@+id/mapPlain"
                android:layout_width="76dp"
                android:layout_height="34dp"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_map_hud_button"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/map_plain"
                android:textFontWeight="600"
                android:textSize="11sp"
                tools:textColor="@color/map_hud_text_quiet" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/mapLegendTower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="@drawable/bg_map_tower_swatch" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/map_legend_tower"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The imagery and the towers are both licensed on condition of
             saying where they came from. -->
        <TextView
            android:id="@+id/mapAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.7"
            android:text="@string/map_attribution"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp" />
    </LinearLayout>
</merge>
