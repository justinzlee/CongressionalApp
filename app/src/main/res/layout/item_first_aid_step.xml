<?xml version="1.0" encoding="utf-8"?>
<!-- One line of first aid. "Do" steps are numbered so the order is obvious;
     the "Don't" list carries a cross instead, since those have no order. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/stepNumber"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:background="@drawable/bg_number_chip"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="11.5sp"
        tools:text="1" />

    <ImageView
        android:id="@+id/stepMark"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:contentDescription="@null"
        android:padding="2dp"
        android:src="@drawable/ic_x_circle"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/stepText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:lineSpacingMultiplier="1.45"
        android:textAppearance="@style/TextAppearance.App.Body"
        tools:text="Soak it in hot water for 30 to 90 minutes." />
</LinearLayout>
