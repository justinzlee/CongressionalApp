<?xml version="1.0" encoding="utf-8"?>
<!-- One band of the UV scale: the sun in that band's colour, the range it
     covers, and what the sun asks of you while it is that high. Colour never
     carries the meaning on its own - the title names the band and its
     numbers, so the row reads the same in greyscale. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:minHeight="56dp"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Same fixed width as the flag key, so the two lessons line their
         titles up at the same place. The flag slot is that wide to hold a
         double red; a sun is only ever one, so it is centred in the slot,
         and the slot runs the full height of the row so the sun sits
         against the title and body together rather than at the top. -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/uvBandIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_sun"
            tools:tint="@color/uv_very_high" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/uvBandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            tools:text="Very high — UV 8–10" />

        <TextView
            android:id="@+id/uvBandBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.45"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="Bare skin starts to burn in about 15 minutes." />
    </LinearLayout>
</LinearLayout>
