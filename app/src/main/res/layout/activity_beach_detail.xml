<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Flat header with a ghost back button, per the design -->
    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/detailBackButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/back"
            android:textColor="@color/primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Photo with the verdict chip pinned to its lower-left -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="168dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/beachDetailImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_image_placeholder"
                        android:contentDescription="@string/beach_image_desc"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hero_scrim" />

                    <LinearLayout
                        android:id="@+id/detailVerdictChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="11dp"
                        android:background="@drawable/bg_verdict_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:id="@+id/detailVerdictIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/safe" />

                        <TextView
                            android:id="@+id/detailVerdictText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/safe"
                            android:textSize="11.5sp"
                            tools:text="Good to swim" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/detailBeachName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.App.Headline"
                tools:text="La Jolla Shores" />

            <TextView
                android:id="@+id/detailBeachMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                tools:text="Lifeguards on duty · 0.8 mi away" />

            <TextView
                android:id="@+id/advisorSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detailSaveButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:text="@string/save_beach"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_bookmark"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/divider" />

            <!-- Fading rule, a Nocturne signature -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/section_conditions"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginEnd="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_wave" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/wave_height" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailWaveHeight"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="3.5 ft" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginStart="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_sun" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/uv_index" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailUvIndex"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="Low (0)" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginEnd="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_wind" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/wind_speed" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailWindSpeed"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="3.3 mph" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginStart="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <!-- Swapped in code for a cold/warm/hot thermometer -->
                        <ImageView
                            android:id="@+id/detailAirTempIcon"
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_thermometer" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/air_temp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailAirTemp"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="75.8°F" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.App.StatTile">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_visibility" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/visibility" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailVisibility"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="10.4 mi" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════ WHAT TO WATCH FOR ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_watch_for"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:id="@+id/hazardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ══════ LIFEGUARDS ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_accent_note"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lifebuoy"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/lifeguards_title"
                        android:textColor="@color/primary_variant"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detailLifeguards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="La Jolla Lifeguard Station is the nearest tower." />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
