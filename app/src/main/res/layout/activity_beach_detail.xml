<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Flat header with a ghost back button, per the design -->
    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- Arrow and word are one target, so "Back" goes back like the arrow -->
        <LinearLayout
            android:id="@+id/detailBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@string/back"
                android:textColor="@color/primary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Photo with the verdict chip pinned to its lower-left -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="168dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/beachDetailImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_image_placeholder"
                        android:contentDescription="@string/beach_image_desc"
                        android:scaleType="centerCrop" />

                    <!-- Darkens the foot of a real photograph so the verdict
                         chip stays readable on it. Hidden when the drawn
                         placeholder is showing: that artwork is already
                         low-contrast behind the chip, and a scrim over it just
                         reads as the illustration being dimmed. -->
                    <View
                        android:id="@+id/detailHeroScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hero_scrim"
                        android:visibility="gone" />

                    <!-- Opposite corner from the verdict chip, so the two
                         things sitting on the picture never collide. -->
                    <ImageView
                        android:id="@+id/detailPhotoButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="11dp"
                        android:background="@drawable/bg_hero_button"
                        android:clickable="true"
                        android:contentDescription="@string/photo_add"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/on_hero" />

                    <LinearLayout
                        android:id="@+id/detailVerdictChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="11dp"
                        android:background="@drawable/bg_verdict_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:id="@+id/detailVerdictIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/safe" />

                        <TextView
                            android:id="@+id/detailVerdictText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/safe"
                            android:textSize="11.5sp"
                            tools:text="Good to swim" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/detailBeachName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.App.Headline"
                tools:text="La Jolla Shores" />

            <TextView
                android:id="@+id/detailBeachMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                tools:text="Lifeguards on duty · 0.8 mi away" />

            <TextView
                android:id="@+id/advisorSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detailSaveButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:text="@string/save_beach"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_bookmark"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/divider" />

            <!-- Fading rule -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divider" />

            <!-- ══════ CONDITIONS ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/section_conditions"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <!-- Wave height gets a card of its own - the swell as a sea to
                 look at - with the rest of the conditions as tiles under it. -->
            <com.example.myapplication.WaveHeightCard
                android:id="@+id/detailWaveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginEnd="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_sun" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/uv_index" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailUvIndex"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="Low (0)" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginStart="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_wind" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/wind_speed" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailWindSpeed"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="3.3 mph" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginEnd="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <!-- Swapped in code for a cold/warm/hot thermometer -->
                        <ImageView
                            android:id="@+id/detailAirTempIcon"
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_thermometer" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/air_temp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailAirTemp"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="75.8°F" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginStart="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <!-- Swapped in code for a cold/warm/hot thermometer -->
                        <ImageView
                            android:id="@+id/detailWaterTempIcon"
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_thermometer" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/water_temp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailWaterTemp"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="68.2°F" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tides: a pair of cubes for the next low and the next high,
                 each with how far off it is. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginEnd="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_tide_low" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/low_tide" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailLowTide"
                        style="@style/Widget.App.StatTileValue"
                        android:text="@string/placeholder_dashes"
                        tools:text="5:04 AM" />

                    <TextView
                        android:id="@+id/detailLowTideCountdown"
                        style="@style/Widget.App.StatTileCaption"
                        android:text="@string/tide_checking"
                        tools:text="in 3h 20m" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.App.StatTile"
                    android:layout_marginStart="4.5dp">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_tide_high" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/high_tide" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailHighTide"
                        style="@style/Widget.App.StatTileValue"
                        android:text="@string/placeholder_dashes"
                        tools:text="11:18 AM" />

                    <TextView
                        android:id="@+id/detailHighTideCountdown"
                        style="@style/Widget.App.StatTileCaption"
                        android:text="@string/tide_checking"
                        tools:text="in 9h 34m" />
                </LinearLayout>
            </LinearLayout>

            <!-- Visibility closes the grid, one tile the full width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.App.StatTile">

                    <LinearLayout style="@style/Widget.App.StatTileLabelRow">

                        <ImageView
                            style="@style/Widget.App.StatTileIcon"
                            android:src="@drawable/ic_visibility" />

                        <TextView
                            style="@style/Widget.App.StatTileLabel"
                            android:text="@string/visibility" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailVisibility"
                        style="@style/Widget.App.StatTileValue"
                        tools:text="10.4 mi" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════ BEACH MAP ══════

                 Right under the conditions section. -->
            <com.example.myapplication.BeachMapCard
                android:id="@+id/detailMapCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <!-- ══════ ENVIRONMENT ══════

                 Combines air quality, water quality, rock ratings, and parking. -->
            <LinearLayout
                android:id="@+id/detailEnvironmentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/section_environment"
                    android:textAppearance="@style/TextAppearance.App.Caption" />

                <!-- Air quality -->
                <LinearLayout
                    android:id="@+id/detailAqiCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="13dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wind"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/aqi_label"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/detailAqiValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            tools:text="AQI 68"
                            tools:textColor="@color/caution" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailAqiBand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="Moderate" />

                    <TextView
                        android:id="@+id/detailAqiAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="Fine for almost everyone." />
                </LinearLayout>

                <!-- Water quality -->
                <LinearLayout
                    android:id="@+id/detailWaterCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="13dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/detailWaterIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wave"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/water_label"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/detailWaterStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            tools:text="Likely clean"
                            tools:textColor="@color/safe" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailWaterBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="No meaningful rain in the last three days." />
                </LinearLayout>

                <!-- Rocks underfoot -->
                <LinearLayout
                    android:id="@+id/detailRocksCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_rock"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/rocks_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/detailRocksValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/primary"
                            android:textSize="17sp"
                            tools:text="7 / 10" />
                    </LinearLayout>

                    <!-- The band when there is a rating ("Mostly rock"), and the
                         "nobody has rated this" line when there is not. -->
                    <TextView
                        android:id="@+id/detailRocksBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        tools:text="Mostly rock" />

                    <TextView
                        android:id="@+id/detailRocksAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        android:visibility="gone"
                        tools:text="Shoes needed, and hard going for small children."
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/detailRocksWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        android:visibility="gone"
                        tools:text="Rated 3 days ago"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/detailRocksPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_image_placeholder"
                        android:contentDescription="@string/rocks_photo_heading"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/detailRocksCta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        tools:text="Rate the rocks" />
                </LinearLayout>

                <!-- Parking -->
                <LinearLayout
                    android:id="@+id/detailParkingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="13dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/parking_label"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailParkingSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="Mostly free parking nearby" />

                    <TextView
                        android:id="@+id/detailParkingDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="6 car parks, 3 street stretches within a 10-minute walk" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/parking_caveat"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════ GOOD FOR TODAY ══════

                 The four activity scores. Below the readings they are built
                 from on purpose: somebody who disagrees with a score should
                 have already scrolled past the wind and the surf that produced
                 it. -->
            <LinearLayout
                android:id="@+id/detailGoodForSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/section_good_for"
                    android:textAppearance="@style/TextAppearance.App.Caption" />

                <LinearLayout
                    android:id="@+id/detailActivityList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ══════ WHAT TO WATCH FOR ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_watch_for"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:id="@+id/hazardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ══════ LIFEGUARDS ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_accent_note"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lifebuoy"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/lifeguards_title"
                        android:textColor="@color/primary_variant"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detailLifeguards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="La Jolla Lifeguard Station is the nearest tower." />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════ WILDLIFE SIGHTINGS ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/sighting_section"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <TextView
                android:id="@+id/detailSightingsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sighting_none"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/detailSightingsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detailSightingCta"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sighting_add_cta"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_dolphin"
                app:strokeColor="@color/divider" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
