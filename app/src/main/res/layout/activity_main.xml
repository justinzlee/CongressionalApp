<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/appContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!--
      Header: the beach this screen is reporting on, named at headline size on
      a line of its own. The name is the answer to "which beach is this?", so
      it gets the full width rather than sharing a row with the buttons and
      being cut short - the kicker and the actions sit above it instead.
    -->
    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/headerKickerRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_map_pin"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/headerKicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/header_kicker_near_you"
                    android:textAppearance="@style/TextAppearance.App.Caption" />
            </LinearLayout>

            <!-- Emergency: every action behind this opens a real system app.
                 The ring behind it swells and fades so the way to help is the
                 one thing on the screen that moves. The ring starts at 0dp and
                 MainActivity sizes it to the pill: a plain View asked to
                 match_parent inside a wrap_content frame takes all the room it
                 is offered, and stretched the frame down the whole screen. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/sosPulse"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:alpha="0"
                    android:background="@drawable/bg_sos_pulse"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/sosButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_sos_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="13dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_first_aid"
                        app:tint="@color/danger" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/sos_label"
                        android:textColor="@color/danger"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <ImageButton
                android:id="@+id/myLocationButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nearby_report_action"
                android:padding="14dp"
                android:src="@drawable/ic_location"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!--
          Long names wrap rather than ellipsize: a name cut to "Jones Beach
          Sta..." is exactly the confusion this row exists to clear up.

          The headline font reserves space above its ascent, which at this size
          reads as a gap under the kicker rather than as leading, so the name
          sits directly beneath it with that padding turned off. The pin icon
          is taller than the kicker text and sets that row's height, so the
          last of the gap is pulled out with a negative margin.
        -->
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false"
            android:text="@string/header_title_default"
            android:textAppearance="@style/TextAppearance.App.Headline"
            tools:text="Malibu Lagoon State Beach" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp">

            <!-- ══════ THE BEACH NEAR YOU ══════

                 The nearest beach's answer to "can I swim right now?" and the
                 readings behind that answer, in one card. The four tiles used
                 to sit in a block of their own below, which read as a second
                 subject; folded in under the sentence, they are plainly the
                 evidence for the line at the top. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verdictCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!--
                      The verdict, at speaking size rather than headline size:
                      the beach name above the card is this screen's headline.
                      A dot in the safety colour carries the state that a band
                      across the card and a badge beside it used to carry
                      between them - one mark, in the one place the eye is
                      already going.
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Painted in code: the dot and its ring both take the
                             safety colour of the moment. See bindVerdict. -->
                        <View
                            android:id="@+id/verdictDot"
                            android:layout_width="16dp"
                            android:layout_height="16dp" />

                        <TextView
                            android:id="@+id/verdictText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/barlow_semi_condensed_semibold"
                            android:textColor="@color/safe"
                            android:textSize="24sp"
                            tools:text="Good to swim" />

                        <TextView
                            android:id="@+id/verdictMeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.TileLabel"
                            tools:text="Updated 4m ago" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/verdictNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        tools:text="Small, manageable waves are running. Still swim between the flags where a patrol is on duty." />

                    <!-- The four readings the verdict is drawn from. No icons:
                         inside the card the labels already sit in a 2x2 block
                         that reads as one set, and four more glyphs only
                         crowd it. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/Widget.App.HeroStatTile"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_surf"
                                android:textAppearance="@style/TextAppearance.App.TileLabel" />

                            <FrameLayout style="@style/Widget.App.HeroStatTileValueSlot">

                                <TextView
                                    android:id="@+id/statSurfValue"
                                    style="@style/Widget.App.HeroStatTileValue"
                                    android:layout_marginTop="0dp"
                                    tools:text="2.8 ft" />

                                <com.example.myapplication.SwellLoaderView
                                    android:id="@+id/statSurfLoader"
                                    style="@style/Widget.App.SwellLoader.InSlot" />
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.App.HeroStatTile"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_uv"
                                android:textAppearance="@style/TextAppearance.App.TileLabel" />

                            <FrameLayout style="@style/Widget.App.HeroStatTileValueSlot">

                                <TextView
                                    android:id="@+id/statUvValue"
                                    style="@style/Widget.App.HeroStatTileValue"
                                    android:layout_marginTop="0dp"
                                    tools:text="Moderate (5)" />

                                <com.example.myapplication.SwellLoaderView
                                    android:id="@+id/statUvLoader"
                                    style="@style/Widget.App.SwellLoader.InSlot" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/Widget.App.HeroStatTile"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_wind"
                                android:textAppearance="@style/TextAppearance.App.TileLabel" />

                            <FrameLayout style="@style/Widget.App.HeroStatTileValueSlot">

                                <TextView
                                    android:id="@+id/statWindValue"
                                    style="@style/Widget.App.HeroStatTileValue"
                                    android:layout_marginTop="0dp"
                                    tools:text="8.7 mph" />

                                <com.example.myapplication.SwellLoaderView
                                    android:id="@+id/statWindLoader"
                                    style="@style/Widget.App.SwellLoader.InSlot" />
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Widget.App.HeroStatTile"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_water"
                                android:textAppearance="@style/TextAppearance.App.TileLabel" />

                            <FrameLayout style="@style/Widget.App.HeroStatTileValueSlot">

                                <TextView
                                    android:id="@+id/statTempValue"
                                    style="@style/Widget.App.HeroStatTileValue"
                                    android:layout_marginTop="0dp"
                                    tools:text="74.6°F" />

                                <com.example.myapplication.SwellLoaderView
                                    android:id="@+id/statTempLoader"
                                    style="@style/Widget.App.SwellLoader.InSlot" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- The way through to the whole report. A ghost button:
                         the card has already said everything urgent, so this
                         is an offer rather than a call. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/verdictDetailsButton"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/beach_details" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════ FIND A BEACH ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="9dp"
                android:text="@string/section_search"
                android:textAppearance="@style/TextAppearance.App.Section" />

            <!--
              Two fields, a radius, and one action, in a card that keeps the
              action on a shelf of its own at the foot. The fields are drawn
              rather than framed - a recessed well with a hairline edge, the
              same treatment as a stat tile - because three stacked outlined
              boxes read as a form, and this is a search.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!--
                          The city. Still a typeable field rather than a plain
                          menu: the list runs to a hundred and fifty coastal
                          towns, and typing three letters beats scrolling to
                          the M's. The caret says it drops down; MainActivity
                          turns it over while the list is open.
                        -->
                        <LinearLayout
                            android:id="@+id/cityField"
                            style="@style/Widget.App.SearchField">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_map_pin"
                                app:tint="@color/primary" />

                            <AutoCompleteTextView
                                android:id="@+id/citySearchEditText"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:completionThreshold="1"
                                android:dropDownAnchor="@id/cityField"
                                android:dropDownHeight="236dp"
                                android:dropDownVerticalOffset="8dp"
                                android:gravity="center_vertical"
                                android:hint="@string/select_coastal_city"
                                android:imeOptions="actionSearch"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:popupBackground="@drawable/bg_search_menu"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="17sp" />

                            <ImageView
                                android:id="@+id/cityCaret"
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <!-- The beach name, filtering the list below as it is
                             typed. The clear mark only appears once there is
                             something to clear. -->
                        <LinearLayout
                            style="@style/Widget.App.SearchField"
                            android:layout_marginTop="10dp">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                app:tint="@color/primary" />

                            <!-- Nothing here is about the person, so there is
                                 nothing for autofill to fill. -->
                            <EditText
                                android:id="@+id/searchEditText"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="11dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:gravity="center_vertical"
                                android:hint="@string/beach_name_hint"
                                android:imeOptions="actionSearch"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="17sp" />

                            <ImageButton
                                android:id="@+id/searchClearButton"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/search_clear"
                                android:padding="8dp"
                                android:src="@drawable/ic_close"
                                android:visibility="gone"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="7dp"
                            android:text="@string/radius_label"
                            android:textAppearance="@style/TextAppearance.App.TileLabel" />

                        <!-- One setting with five positions, not five buttons:
                             the tray is the control, and only the chip that is
                             on is drawn. -->
                        <LinearLayout
                            android:id="@+id/radiusChipRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_radius_tray"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/radiusStep1"
                                style="@style/Widget.App.RadiusChip"
                                tools:text="5 mi" />

                            <TextView
                                android:id="@+id/radiusStep2"
                                style="@style/Widget.App.RadiusChip"
                                android:layout_marginStart="4dp"
                                tools:text="10 mi" />

                            <TextView
                                android:id="@+id/radiusStep3"
                                style="@style/Widget.App.RadiusChip"
                                android:layout_marginStart="4dp"
                                tools:text="25 mi" />

                            <TextView
                                android:id="@+id/radiusStep4"
                                style="@style/Widget.App.RadiusChip"
                                android:layout_marginStart="4dp"
                                tools:text="50 mi" />

                            <TextView
                                android:id="@+id/radiusAll"
                                style="@style/Widget.App.RadiusChip"
                                android:layout_marginStart="4dp"
                                android:text="@string/radius_all" />
                        </LinearLayout>

                        <!-- Why four of the five chips are dimmed, when they
                             are. Gone the moment there is a position to
                             measure from. -->
                        <TextView
                            android:id="@+id/radiusHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/radius_needs_location"
                            android:textAppearance="@style/TextAppearance.App.Subtitle"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/search_footer"
                        android:orientation="vertical"
                        android:paddingLeft="16dp"
                        android:paddingTop="14dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:id="@+id/citySearchButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_search_cta"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- A ring that swells out of the pin and fades,
                                 the way a fix lands on a map. Driven from
                                 MainActivity.

                                 The pin is pulled back over the ring with a
                                 negative margin rather than stacked in a
                                 FrameLayout: this screen is already ten
                                 levels deep, and a frame here is one level
                                 spent on two views that never move apart. -->
                            <View
                                android:id="@+id/citySearchPulse"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:alpha="0"
                                android:background="@drawable/bg_pulse_ring" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="-16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_map_pin"
                                app:tint="@color/on_primary" />

                            <TextView
                                android:id="@+id/citySearchLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/find_nearby_beaches"
                                android:textColor="@color/on_primary"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════ BEST BEACH FOR… ══════

                 For knowing what you want to do and not which beach suits it.
                 Below the search card, so the city, name and radius come
                 first. -->
            <LinearLayout
                android:id="@+id/bestForCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_accent_note"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_picnic"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/activity_title"
                        android:textColor="@color/primary_variant"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/activity_pick"
                        android:textAppearance="@style/TextAppearance.App.Subtitle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- ══════ NEARBY BEACHES ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nearby_beaches"
                    android:textAppearance="@style/TextAppearance.App.Section" />

                <TextView
                    android:id="@+id/beachCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textSize="13sp"
                    tools:text="12 beaches" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/beachRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_surface_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_map_pin"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/empty_state_title"
                    android:textAppearance="@style/TextAppearance.App.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_state_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Subtitle" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_tab_bar" />

</LinearLayout>

    <!-- Launch screen: the Flagline mark over open sea, held while the app
         behind it finds its feet, then crossed out to it. Drawn on top of the
         real screen rather than in its own activity, so there is nothing to
         start and nothing to tear down - it simply stops being there. -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.example.myapplication.FlaglineSplashView
            android:id="@+id/splashBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- The mark sits exactly where Android's own splash put the launcher
             icon a moment earlier - dead centre, the same height of pole - so
             the hand-over from the system splash is a continuation rather
             than a jump. The words appear below it. -->
        <com.example.myapplication.FlaglineMarkView
            android:id="@+id/splashMark"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="150dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- The sheet sets the wordmark in Poppins 600. Android ships
                 Roboto, whose weights step 500 then 700 with nothing between,
                 and at 46sp the 500 reads thin beside the drawn mark, so the
                 wordmark takes the bold. -->
            <TextView
                android:id="@+id/splashWordmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:letterSpacing="-0.035"
                android:text="@string/app_name"
                android:textColor="@color/brand_shell"
                android:textSize="46sp"
                android:textStyle="bold" />

            <!-- Tracking is animated open on the way in, so the padding that
                 keeps it optically centred is set in code alongside it. -->
            <TextView
                android:id="@+id/splashTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="@string/app_tagline"
                android:textColor="@color/brand_foam"
                android:textSize="17sp" />

            <!-- Shown only if the intro ends before the nearest beach has a
                 reading: the launch screen then waits for it, and says what
                 it is waiting for, rather than handing over to a card that
                 says "Checking conditions". -->
            <LinearLayout
                android:id="@+id/splashWaiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:alpha="0"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:importantForAccessibility="no"
                    app:indicatorColor="@color/brand_foam"
                    app:trackColor="@color/brand_foam_track"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="3dp" />

                <TextView
                    android:id="@+id/splashStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="32dp"
                    android:textColor="@color/brand_foam"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
