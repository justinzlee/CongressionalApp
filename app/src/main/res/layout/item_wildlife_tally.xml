<?xml version="1.0" encoding="utf-8"?>
<!-- One animal group in the fortnight's count on the beach screen: its icon,
     its name, and how many times it was seen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/tallyIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        app:tint="@color/text_secondary"
        tools:src="@drawable/ic_seal" />

    <TextView
        android:id="@+id/tallyLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        tools:text="Seal" />

    <TextView
        android:id="@+id/tallyCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.App.Subtitle"
        tools:text="36" />
</LinearLayout>
