<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Flagline ships. Android 13 and up reads this to list the app in
  the system's per-app language screen, so the setting inside the app and the
  one in Settings offer the same choices.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="zh" />
</locale-config>
