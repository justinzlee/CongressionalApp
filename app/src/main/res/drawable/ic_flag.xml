<?xml version="1.0" encoding="utf-8"?>
<!--
  A lifeguard flag on its pole, drawn in one colour so app:tint paints the
  whole mark in whichever warning colour the row is showing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Pole -->
    <path
        android:pathData="M4.7,3.6 L4.7,20.4"
        android:strokeColor="#000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />
    <!-- Cloth, with the slack of a flag in light wind -->
    <path
        android:fillColor="#000000"
        android:pathData="M5.6,5.1 C9.2,3.7 13.1,6.5 16.7,5.1 C18.4,4.4 19.6,4.6 20.3,4.9 L20.3,13.5 C19.6,13.2 18.4,13 16.7,13.7 C13.1,15.1 9.2,12.3 5.6,13.7 Z" />
</vector>
