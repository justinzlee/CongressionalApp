<?xml version="1.0" encoding="utf-8"?>
<!-- Round button sitting on the detail hero. Sea 800 at 80% with a hairline
     of white, the same treatment as the verdict chip in the opposite corner:
     both have to stay legible on a photograph, so both stay dark in either
     theme rather than following the app ground. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#CC06303D" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
