                C3.0,13.9 2.0,14.9 0.9,15.7
                C0.4,16.1 -0.2,15.6 0.1,15.0
                C0.8,13.6 1.2,12.6 1.2,12.0
                C1.2,11.4 0.8,10.4 0.1,9.0
                C-0.2,8.4 0.4,7.9 0.9,8.3
                C2.0,9.1 3.0,10.1 3.6,11.0
                L3.6,11.1
                C5.2,10.4 6.9,9.8 8.6,9.4
                C8.9,7.7 9.5,6.0 10.5,4.6
                C10.9,4.1 11.6,4.4 11.6,5.0
