    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Moves the drawing so its ink is centred in the 24x24 frame. -->
    <group android:translateX="0.42" android:translateY="0.13">
        <path
            android:fillColor="#000000"
            android:pathData="M23.0,11.7
                C21.8,12.0 20.2,12.5 18.6,13.2
                C16.7,14.5 14.2,15.2 11.4,15.0
                C8.6,14.8 6.0,14.0 3.6,12.9
