<?xml version="1.0" encoding="utf-8"?>
<!--
  The coastal-city list that drops out of the city field. A card in its own
  right rather than the platform's square popup, with room around the rows so
  the highlighted one reads as a pill inside it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_alt" />
    <stroke android:width="1dp" android:color="@color/divider" />
    <corners android:radius="14dp" />
    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp" />
</shape>
