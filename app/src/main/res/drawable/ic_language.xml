<?xml version="1.0" encoding="utf-8"?>
<!--
  Globe for the language row: circle, equator and one meridian, stroked on the
  24px grid with round caps at the same weight as ic_moon, which sits beside it
  in the same settings card and renders at the same 20dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Globe -->
    <path
        android:pathData="M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 Z"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Equator -->
    <path
        android:pathData="M3,12 L21,12"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Meridian: a wide arc each way, so the sphere reads as turned towards you -->
    <path
        android:pathData="M12,3 A13,13 0 0,0 12,21 A13,13 0 0,0 12,3 Z"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
