<?xml version="1.0" encoding="utf-8"?>
<!--
  "Something else": a question mark, not an animal.

  Every other mark on the report screen is a silhouette of the thing it stands
  for, and this one deliberately is not. Any creature drawn here would be read
  as a suggestion - a paw print says land mammal, a generic fish says fish - and
  the whole purpose of this option is that the reporter could not say. A
  question mark claims nothing, which is the point.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12,12 m-9,0 a9,9 0,1 0,18 0 a9,9 0,1 0,-18 0"
        android:strokeColor="#000000"
        android:strokeWidth="1.6" />

    <path
        android:pathData="M9.3,9.4 C9.3,7.7 10.5,6.6 12.1,6.6 C13.7,6.6 14.9,7.7 14.9,9.2 C14.9,10.6 14.0,11.2 13.1,11.9 C12.4,12.4 12.0,13.0 12.0,14.0"
        android:strokeColor="#000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <path
        android:pathData="M12,16.6 m-0.95,0 a0.95,0.95 0,1 0,1.9 0 a0.95,0.95 0,1 0,-1.9 0"
        android:fillColor="#000000" />
</vector>
