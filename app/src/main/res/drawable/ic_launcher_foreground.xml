<?xml version="1.0" encoding="utf-8"?>
<!--
  Flagline mark, icon lockup: a warning flag on its pole with the waterline
  running beneath it, drawn in sand and coral on the sea tile.

  The identity sheet's 128 px icon draws its 64-box mark at 100 px, so the ink
  covers about 69% of the tile. An adaptive icon only shows the middle 72dp of
  its 108dp canvas, so the same proportion here is 0.88 of the mark box, which
  puts the ink inside 29..79 on both axes - clear of every mask.

  The group transform does the scaling, so the paths below are the identity
  sheet's own path data, unaltered and readable against the handoff.

  The launch screen flies four flags on this pole rather than one; an icon that
  has to survive 32 px does not have room for four, and the sheet is explicit
  that the flag and pole are the parts that may never be dropped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:translateX="26.72"
        android:translateY="25.84">
        <!-- Waterline: foam, under everything else -->
        <path
            android:pathData="M5,51c9,0 9,-5 18,-5s9,5 18,5 9,-5 16,-5"
            android:strokeColor="#9CD3DB"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />
        <!-- Pole: sand -->
        <path
            android:pathData="M18,8v48"
            android:strokeColor="#EDE6DA"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <!-- Flag: coral, the one colour reserved for the mark -->
        <path
            android:fillColor="#EA5C41"
            android:pathData="M21,11h29l-10,12 10,12H21z" />
    </group>
</vector>
