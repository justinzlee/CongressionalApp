<?xml version="1.0" encoding="utf-8"?>
<!--
  Sandbar mark, icon lockup: three stacked bands for water, sun and sand,
  right-aligned so the stack leans the way the wordmark does.

  An adaptive icon only shows the middle 72dp of its 108dp canvas, so the
  design's 64x64 mark box is drawn here at 52dp (0.8125 scale) on that visible
  area - a little over the design's 60%, which a mask this tight can carry.

  Centring is optical, not arithmetic. Two corrections, both scaled with the
  mark: the ink sits low in the 64-box, so the stack lifts by half a band; and
  because the bands right-align and the widest one is on top, the mark's mass
  sits up and to the right of its bounding box, so the whole thing shifts 2.6
  left and 1.2 down (roughly half the centroid offset each way). Ink lands
  centred on 51.9, 55.0 rather than dead-centre 54, 54.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Water: sand-coloured on the teal tile -->
    <path
        android:fillColor="#EDE6DA"
        android:pathData="M34.41875,39.94375 H69.35625 A3.65625,3.65625 0 0 1 69.35625,47.25625 H34.41875 A3.65625,3.65625 0 0 1 34.41875,39.94375 Z" />
    <!-- Sun: the amber keeps the middle -->
    <path
        android:fillColor="#F7A828"
        android:pathData="M42.54375,51.31875 H69.35625 A3.65625,3.65625 0 0 1 69.35625,58.63125 H42.54375 A3.65625,3.65625 0 0 1 42.54375,51.31875 Z" />
    <!-- Sand: drops to 50% so it reads as the band furthest up the beach -->
    <path
        android:fillColor="#EDE6DA"
        android:fillAlpha="0.5"
        android:pathData="M51.48125,62.69375 H69.35625 A3.65625,3.65625 0 0 1 69.35625,70.00625 H51.48125 A3.65625,3.65625 0 0 1 51.48125,62.69375 Z" />
</vector>
