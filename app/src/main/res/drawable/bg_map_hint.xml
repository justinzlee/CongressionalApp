<?xml version="1.0" encoding="utf-8"?>
<!-- The two-finger hint over the middle of the map. The controls' own
     near-solid surface rather than the scale pill's see-through one: it lands
     on the beach, and a tower marker showing through would cut the words. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/map_hud" />
    <stroke android:width="1dp" android:color="@color/map_hud_edge" />
    <corners android:radius="999dp" />
</shape>
