<?xml version="1.0" encoding="utf-8"?>
<!--
  A field inside a card: the city picker and the beach-name box. Recessed a
  step from the card it sits on, with the same hairline edge every surface in
  this app carries. radius-xl 14dp, the design's own field corner.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_alt" />
    <corners android:radius="12dp" />
</shape>
