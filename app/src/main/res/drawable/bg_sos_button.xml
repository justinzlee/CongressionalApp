<?xml version="1.0" encoding="utf-8"?>
<!-- SOS pill in the home header: danger tint behind a danger edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/danger_tint" />
    <stroke android:width="1dp" android:color="@color/danger" />
    <corners android:radius="999dp" />
</shape>
