<?xml version="1.0" encoding="utf-8"?>
<!--
  An open book for the Learn tab, drawn as two facing pages on a spine in one
  colour so app:tint paints the whole mark the way the other tab icons do.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Left page, curving up away from the spine -->
    <path
        android:pathData="M11.2,7.2 C9.5,5.9 7.1,5.4 3.8,5.4 L3.8,17.1 C7.1,17.1 9.5,17.6 11.2,18.9 Z"
        android:strokeColor="#000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <!-- Right page, mirrored -->
    <path
        android:pathData="M12.8,7.2 C14.5,5.9 16.9,5.4 20.2,5.4 L20.2,17.1 C16.9,17.1 14.5,17.6 12.8,18.9 Z"
        android:strokeColor="#000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <!-- Spine -->
    <path
        android:pathData="M12,7.6 L12,18.6"
        android:strokeColor="#000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
</vector>
