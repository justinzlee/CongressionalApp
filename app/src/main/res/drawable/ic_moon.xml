<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode mark from the "Dark Mode Icon" design (variant 2a, crescent +
  spark): a stroked crescent on the 24px grid with a small star in the notch,
  round caps and joins, drawn in a single colour so it inverts with the tint.

  The design draws it at a 1.75 stroke and says to bump to 2 at 20px and
  below so the spark's arms stay open - the settings row renders it at 20dp,
  so that is the weight used here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Crescent -->
    <path
        android:pathData="M19.4,15.2 A8,8 0 0,1 9.2,5 A8,8 0 1,0 19.4,15.2 Z"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Spark, sitting in the crescent's notch -->
    <path
        android:pathData="M17.4,3 L17.4,6.6 M15.6,4.8 L19.2,4.8"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
