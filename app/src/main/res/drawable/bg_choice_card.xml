<?xml version="1.0" encoding="utf-8"?>
<!--
  An unselected choice on the sighting form — a species, or where the animal was.

  Drawn unselected and re-coloured in code when it is picked, the same way the
  coast chips on the wildlife guide work. Both the fill and the stroke change,
  and the icon and label are tinted alongside them, which is more than a state
  selector can do from a drawable alone.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/surface" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
