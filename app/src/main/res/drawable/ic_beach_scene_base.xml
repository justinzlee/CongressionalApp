<?xml version="1.0" encoding="utf-8"?>
<!--
  The shoreline every beach placeholder is built on: sky, sun, clouds, gulls,
  sea, horizon, swell and sand. It carries nothing that stands on the
  beach, and no kite - those come from one of the ic_beach_object_* layers
  stacked over it, each of which flies a kite of its own,
  so that an unphotographed beach in Maine does not look like the same drawing
  as one in Hawaii.

  Framed at 260x100 rather than the 2:1 the scene was drawn at, because the two
  slots it has to survive are different shapes: the detail card is about 2:1 and
  a nearby-beach row is nearer 3:1, and both use centerCrop. So the sky, sea and
  sand run edge to edge while every object is kept inside x 12%-88% and
  y 10%-90%, the window that survives the worst crop either slot can ask for.
  Nothing that reads as a thing gets cut.

  Colours come from placeholder_* tokens, which have an after-dark set in
  values-night. Which set is used is decided by BeachPlaceholder from sunrise
  and sunset at the beach own coordinates, not from the phone theme, so a
  beach is drawn the way it would actually look right now.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="260dp"
    android:height="100dp"
    android:viewportWidth="260"
    android:viewportHeight="100">

    <!-- Sky, down to the horizon at y=53.5 -->
    <path android:pathData="M0,0h260v54h-260z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="53.5">
                <item android:offset="0" android:color="@color/placeholder_sky" />
                <item android:offset="0.52" android:color="@color/placeholder_sky_mid" />
                <item android:offset="0.88" android:color="@color/placeholder_sky_low" />
                <item android:offset="1" android:color="@color/placeholder_sky_haze" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sun: a soft halo, then the disc laid over it -->
    <path android:pathData="M41.18,27.4 a17.4,17.4,0,1,0,34.8,0 a17.4,17.4,0,1,0,-34.8,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="58.58" android:centerY="27.4" android:gradientRadius="17.4">
                <item android:offset="0" android:color="@color/placeholder_sun_glow" />
                <item android:offset="0.7" android:color="@color/placeholder_sun_glow" />
                <item android:offset="1" android:color="@color/placeholder_sun_glow_fade" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M46.4,27.4 a12.18,12.18,0,1,0,24.36,0 a12.18,12.18,0,1,0,-24.36,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="55.19" android:centerY="23.05" android:gradientRadius="22.79">
                <item android:offset="0" android:color="@color/placeholder_sun_core" />
                <item android:offset="0.56" android:color="@color/placeholder_sun_mid" />
                <item android:offset="1" android:color="@color/placeholder_sun_edge" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Two clouds, each a stack of lozenges rather than one puffy blob -->
    <path
        android:fillColor="@color/placeholder_light"
        android:pathData="M45.97,19.57 H63.08 A3.04,3.04,0,0,1,63.08,25.66 H45.97 A3.04,3.04,0,0,1,45.97,19.57 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:pathData="M54.08,17.54 H71.18 A2.17,2.17,0,0,1,71.18,21.89 H54.08 A2.17,2.17,0,0,1,54.08,17.54 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:pathData="M61.63,22.18 H78.74 A1.02,1.02,0,0,1,78.74,24.21 H61.63 A1.02,1.02,0,0,1,61.63,22.18 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:fillAlpha="0.82"
        android:pathData="M143.73,33.49 H155.63 A2.17,2.17,0,0,1,155.63,37.84 H143.73 A2.17,2.17,0,0,1,143.73,33.49 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:fillAlpha="0.82"
        android:pathData="M150.11,32.33 H162 A1.3,1.3,0,0,1,162,34.94 H150.11 A1.3,1.3,0,0,1,150.11,32.33 Z" />

    <!-- Three gulls, far enough off to be shorthand -->
    <path
        android:strokeColor="@color/placeholder_bird"
        android:strokeWidth="0.44"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round"
        android:pathData="M114.83,21.41 q1.34,-1.34,2.69,0 q1.34,-1.34,2.69,0" />
    <path
        android:strokeColor="@color/placeholder_bird"
        android:strokeWidth="0.44"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round"
        android:pathData="M122.59,19.62 q1.04,-1.04,2.09,0 q1.04,-1.04,2.09,0" />
    <path
        android:strokeColor="@color/placeholder_bird"
        android:strokeWidth="0.44"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round"
        android:pathData="M128.55,22.3 q0.9,-0.9,1.79,0 q0.9,-0.9,1.79,0" />

    <!-- Sea, deepening away from the shore -->
    <path android:pathData="M0,53.5h260v46.5h-260z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="53.5"
                android:endX="0" android:endY="100">
                <item android:offset="0" android:color="@color/placeholder_sea_shore" />
                <item android:offset="0.26" android:color="@color/placeholder_sea" />
                <item android:offset="0.58" android:color="@color/placeholder_sea_mid" />
                <item android:offset="1" android:color="@color/placeholder_sea_deep" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Light catching the horizon -->
    <path android:pathData="M0,53.5h260v0.87h-260z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="260" android:endY="0">
                <item android:offset="0" android:color="@color/placeholder_horizon_edge" />
                <item android:offset="0.5" android:color="@color/placeholder_horizon_core" />
                <item android:offset="1" android:color="@color/placeholder_horizon_edge" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Swell: two far lines, then a nearer, heavier one. Each starts and ends
         off-frame so no crop can reveal a stroke end. -->
    <path
        android:strokeColor="@color/placeholder_light"
        android:strokeWidth="0.87"
        android:strokeAlpha="0.65"
        android:strokeLineCap="round"
        android:pathData="M-22.25,58.07 q10.88,-2.94 21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0 t21.75,0" />
    <path
        android:strokeColor="@color/placeholder_light"
        android:strokeWidth="0.87"
        android:strokeAlpha="0.65"
        android:strokeLineCap="round"
        android:pathData="M-26.6,65.9 q13.05,-3.59 26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0 t26.1,0" />
    <path
        android:strokeColor="@color/placeholder_swell_near"
        android:strokeWidth="1.39"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round"
        android:pathData="M-35.3,73.73 q15.66,-4.57 31.32,0 t31.32,0 t31.32,0 t31.32,0 t31.32,0 t31.32,0 t31.32,0 t31.32,0 t31.32,0 t31.32,0" />

    <!-- Beach: wet sand, the foam line along its edge, then dry sand -->
    <path
        android:fillColor="@color/placeholder_sand_wet"
        android:pathData="M-20,81 C5,75 35,73 70,77.5 C105,80 140,74 175,77 C205,80.5 235,74.5 280,72.5 L280,100 L-20,100 Z" />
    <path
        android:strokeColor="@color/placeholder_light"
        android:strokeWidth="1.48"
        android:pathData="M-20,81 C5,75 35,73 70,77.5 C105,80 140,74 175,77 C205,80.5 235,74.5 280,72.5" />
    <path
        android:fillColor="@color/placeholder_sand_dry"
        android:pathData="M-20,86.5 C20,82.5 65,88.5 115,85.5 C165,82.5 215,88 280,83.5 L280,100 L-20,100 Z" />

</vector>
