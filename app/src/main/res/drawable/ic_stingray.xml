<?xml version="1.0" encoding="utf-8"?>
<!--
  Stingray seen from above. The disc is drawn wide and flat with the wingtips
  swept back past the body, and the tail runs most of the height of the icon:
  at list size a rounder disc over a short tail just reads as a mushroom.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Disc, wingtips swept back to the outer corners -->
    <path
        android:pathData="M12,6.4 C15.4,7.4 19.4,9.8 22,13.6 C18.6,13.3 16.4,12.9 14.6,12.4 C13.8,12.9 13,13.1 12,13.1 C11,13.1 10.2,12.9 9.4,12.4 C7.6,12.9 5.4,13.3 2,13.6 C4.6,9.8 8.6,7.4 12,6.4 Z"
        android:strokeColor="#000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <!-- Tail, long and kinked the way it whips -->
    <path
        android:pathData="M12,13.1 C12.5,15.6 11.7,17.6 12.4,19.4 C12.8,20.4 12.6,21 12.3,21.6"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M10.5,9.3 m-0.75,0 a0.75,0.75 0,1 0,1.5 0 a0.75,0.75 0,1 0,-1.5 0"
        android:fillColor="#000000" />
    <path
        android:pathData="M13.5,9.3 m-0.75,0 a0.75,0.75 0,1 0,1.5 0 a0.75,0.75 0,1 0,-1.5 0"
        android:fillColor="#000000" />
</vector>
