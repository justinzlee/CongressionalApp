<?xml version="1.0" encoding="utf-8"?>
<!-- Verdict chip over the detail photo; the stroke is tinted in code to
     the beach's own safety color. Sea 800 at 80%, dark in both themes
     because it sits on a photograph rather than on the app ground. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC06303D" />
    <stroke android:width="1dp" android:color="@color/divider" />
    <corners android:radius="6dp" />
</shape>
