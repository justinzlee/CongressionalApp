<?xml version="1.0" encoding="utf-8"?>
<!--
  A shorebird, head to the right, in the same single-weight outline as
  ic_seagull.

  Every bird that is not a gull shares this card, so it is drawn as the other
  bird every beach has: a sandpiper at the water's edge. Long thin legs and a
  long thin beak are what set it apart from the gull beside it on the report
  form, whose heavy hooked beak and single short leg say "gull" at any size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Body and head as one silhouette, tail tipped up to the left -->
    <path
        android:pathData="M2.6,9.0 C5.2,9.4 7.8,9.0 10.4,8.6 C11.2,6.6 12.6,5.4 14.4,5.4 C16.0,5.4 17.2,6.6 17.2,8.0 C17.2,10.8 15.4,13.2 12.4,13.6 C8.8,14.0 5.0,12.4 2.6,9.0 Z"
        android:strokeColor="#000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Long straight beak -->
    <path
        android:pathData="M17.0,8.0 L22.0,9.4"
        android:strokeColor="#000000"
        android:strokeWidth="1.4"
        android:strokeLineCap="round" />

    <!-- Folded wing -->
    <path
        android:pathData="M6.2,11.0 C8.0,10.0 10.2,9.8 12.4,10.4"
        android:strokeColor="#000000"
        android:strokeWidth="1.4"
        android:strokeLineCap="round" />

    <!-- Two long legs -->
    <path
        android:pathData="M10.6,13.6 L9.8,19.4 M13.2,13.4 L13.8,19.4 M8.6,19.4 L10.6,19.4 M13.2,19.4 L15.2,19.4"
        android:strokeColor="#000000"
        android:strokeWidth="1.3"
        android:strokeLineCap="round" />

    <path
        android:pathData="M14.6,7.6 m-0.75,0 a0.75,0.75 0,1 0,1.5 0 a0.75,0.75 0,1 0,-1.5 0"
        android:fillColor="#000000" />
</vector>
