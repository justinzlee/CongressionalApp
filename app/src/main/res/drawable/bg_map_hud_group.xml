<?xml version="1.0" encoding="utf-8"?>
<!-- A group of controls floating over the map - zoom, and satellite or
     plain - in the card's own surface for the theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/map_hud" />
    <stroke android:width="1dp" android:color="@color/map_hud_edge" />
    <corners android:radius="12dp" />
</shape>
