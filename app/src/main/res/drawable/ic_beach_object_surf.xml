<?xml version="1.0" encoding="utf-8"?>
<!--
  A surfboard planted in the sand beside a striped towel, under a quartered kite.

  Drawn over ic_beach_scene_base in the same 260x100 frame, so the two line up
  exactly. The kite belongs to this layer rather than the base: Round 8 flies a
  different one over every scene, so it changes with the props.

  Sizes come from the design directly: the frame's height matches the design
  card's, so one percent of the card's width is two units here. Only the ground
  line is moved - props stand at y 89 rather than the design's y 98, to stay
  inside the band that survives a centreCrop into a 3:1 list row.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="260dp"
    android:height="100dp"
    android:viewportWidth="260"
    android:viewportHeight="100">

    <!-- The kite this scene flies -->
    <group
        android:translateX="191"
        android:translateY="10"
        android:scaleX="0.2889"
        android:scaleY="0.2889">
        <path
            android:fillColor="@color/placeholder_light"
            android:strokeColor="@color/placeholder_sea_deep"
            android:strokeWidth="1.6"
            android:pathData="M45,6 L69,38 L45,70 L21,38 Z" />
        <path
            android:fillColor="@color/placeholder_sea"
            android:pathData="M45,6 L69,38 L45,38 Z" />
        <path
            android:fillColor="@color/placeholder_accent"
            android:pathData="M45,38 L21,38 L45,70 Z" />
        <path
            android:strokeColor="@color/placeholder_kite_tail"
            android:strokeWidth="1.6"
            android:strokeAlpha="0.5"
            android:pathData="M45,70 q11,13 -4,20 q15,7 4,15" />
    </group>

    <group
        android:translateX="41"
        android:translateY="38.5"
        android:scaleX="0.5"
