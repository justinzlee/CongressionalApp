    <path
        android:strokeColor="@color/placeholder_accent_edge"
        android:strokeWidth="0.57"
        android:strokeLineJoin="round"
        android:pathData="M49.49,78.08 Q50.25,71.23,63.96,68.19 Q77.66,71.23,78.41,78.08 q-2.41,1.91,-4.82,0 q-2.41,1.91,-4.82,0 q-2.41,1.91,-4.82,0 q-2.41,1.91,-4.82,0 q-2.41,1.91,-4.82,0 q-2.41,1.91,-4.82,0 Z" />
    <path
        android:fillColor="@color/placeholder_pole"
        android:pathData="M63.04,68.19 a0.91,0.91,0,1,0,1.83,0 a0.91,0.91,0,1,0,-1.83,0 Z" />

    <!-- Beach ball, left where someone set it down -->
