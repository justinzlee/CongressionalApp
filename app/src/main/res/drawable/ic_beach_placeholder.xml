        android:fillColor="@color/placeholder_light"
        android:pathData="M45.97,19.57 H63.08 A3.04,3.04,0,0,1,63.08,25.66 H45.97 A3.04,3.04,0,0,1,45.97,19.57 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:pathData="M54.08,17.54 H71.18 A2.17,2.17,0,0,1,71.18,21.89 H54.08 A2.17,2.17,0,0,1,54.08,17.54 Z" />
