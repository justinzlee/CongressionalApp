            android:pathData="M63.96,68.19 L49.49,79.6 L54.32,79.6 Z" />
        <path
            android:fillColor="@color/placeholder_accent"
            android:pathData="M63.96,68.19 L59.12,79.6 L63.96,79.6 Z" />
        <path
            android:fillColor="@color/placeholder_accent"
            android:pathData="M63.96,68.19 L68.78,79.6 L73.58,79.6 Z" />
        <path
            android:fillColor="@color/placeholder_accent"
            android:pathData="M63.96,68.19 L78.41,79.6 L81.46,79.6 Z" />
