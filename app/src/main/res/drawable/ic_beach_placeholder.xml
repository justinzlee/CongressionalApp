        android:fillColor="@color/placeholder_shade"
        android:fillAlpha="0.5"
        android:pathData="M98.77,86.02 a4.25,0.85,0,1,0,8.49,0 a4.25,0.85,0,1,0,-8.49,0 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:pathData="M96.81,79.16 a5.87,5.87,0,1,0,11.74,0 a5.87,5.87,0,1,0,-11.74,0 Z" />
    <path
        android:fillColor="@color/placeholder_accent"
        android:pathData="M102.69,79.16 L102.69,73.29 A5.87,5.87,0,0,1,107.42,76.07 Z" />
    <path
        android:fillColor="@color/placeholder_sea"
        android:pathData="M102.69,79.16 L107.42,82.26 A5.87,5.87,0,0,1,102.69,85.04 Z" />
    <path
        android:fillColor="@color/placeholder_sun_edge"
        android:pathData="M102.69,79.16 L97.95,82.26 A5.87,5.87,0,0,1,97.95,76.07 Z" />
    <path
        android:fillColor="@color/placeholder_light"
        android:strokeColor="@color/placeholder_accent_edge"
        android:strokeWidth="0.39"
        android:pathData="M101.58,79.16 a1.11,1.11,0,1,0,2.22,0 a1.11,1.11,0,1,0,-2.22,0 Z" />
    <path
